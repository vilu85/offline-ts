{
	"name": "@vilucloud/offline-ts",
	"version": "1.0.0",
	"description": "Browser connectivity checking tool",
	"main": "./dist/offline.umd.js",
	"module": "./dist/offline.js",
	"browser": "./dist/offline.umd.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/offline.js",
			"require": "./dist/offline.umd.js",
			"default": "./dist/offline.js"
		}
	},
	"files": [
		"dist/",
		"types/",
		"src/",
		"package.json"
	],
	"scripts": {
		"clean": "rimraf dist types",
		"build": "npm run clean && webpack",
		"build:production": "npm run clean && cross-env NODE_ENV=production webpack",
		"watch": "webpack --watch",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"lint": "eslint .",
		"prepack": "npm run build:production"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vilu85/offline-ts.git"
	},
	"author": "Ville Perkkio",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/vilu85/offline-ts/issues"
	},
	"homepage": "https://github.com/vilu85/offline-ts#readme",
	"browserslist": [
		"> 1%",
		"ie >= 8",
		"edge >= 15",
		"ie_mob >= 10",
		"ff >= 14",
		"chrome >= 45",
		"safari >= 7",
		"opera >= 10",
		"ios >= 7",
		"android >= 4",
		"bb >= 10",
		"electron >= 1",
		"last 5 versions",
		"not dead"
	],
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/runtime": "^8.0.5",
		"@eslint/js": "^10.0.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/jest": "^30.0.0",
		"@typescript-eslint/eslint-plugin": "^8.59.4",
		"browserslist": "^4.28.9",
		"cross-env": "^10.1.0",
		"eslint": "^10.4.0",
		"eslint-plugin-jest": "^29.15.0",
		"globals": "^17.6.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.4",
		"rimraf": "^6.1.3",
		"terser-webpack-plugin": "^5.6.1",
		"ts-jest": "^29.4.11",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"url-loader": "^4.1.1",
		"webpack": "^5.110.3",
		"webpack-cli": "^7.2.3"
	},
	"overrides": {
		"js-yaml": ">=4.2.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
